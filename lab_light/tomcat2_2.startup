ip address add 192.168.2.20/24 dev eth0
ip route add 0.0.0.0/0 via 192.168.2.1 dev eth0

/bin/bash /shared/init_caldera_br_sandcat.sh
echo 'nameserver 1.1.1.1' >> /etc/resolv.conf

WAZUH_MANAGER='192.168.2.23' WAZUH_AGENT_NAME=$HOSTNAME dpkg -i /shared/wazuh-agent_4.9.0-1_amd64.deb
service wazuh-agent start

export CATALINA_OPTS="$CATALINA_OPTS -Dlog4j2.formatMsgNoLookups=false -Dcom.sun.jndi.ldap.object.trustURLCodebase=true"

cp -v /shared/tomcat/log4j-api-2.14.1.jar /usr/local/tomcat/lib/
cp -v /shared/tomcat/log4j-core-2.14.1.jar /usr/local/tomcat/lib/
cp -v /shared/tomcat/log4j2.xml /usr/local/tomcat/lib/ # Anche la configurazione

mkdir -p /usr/local/tomcat/webapps/vulnerable

cp -v /shared/tomcat/vuln.jsp /usr/local/tomcat/webapps/vulnerable/index.jsp
